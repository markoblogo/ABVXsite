{
  "schemaVersion": 1,
  "kind": "CortexABVVectorRetrievalPilotPlan",
  "version": "v1",
  "authority": "plan_only",
  "runtimeIntegration": false,
  "externalSideEffects": false,
  "engine": "turbovec",
  "engineNotes": {
    "goal": "pilot_local_retrieval_only",
    "notes": [
      "TurboQuant allows local ANN retrieval with compressed index and candidate allowlisting.",
      "This plan is read-only, proposal-grade, and synthetic-only until governance gates are passed."
    ],
    "reference": "https://github.com/RyanCodrai/turbovec"
  },
  "indexInterface": {
    "mode": "ann_with_tfidf_fallback",
    "runtimeReady": false,
    "indexBuildPolicy": "bounded_local",
    "fallback": {
      "engine": "tfidf-lite",
      "reason": "runtimeIntegration=false in pilot: tf-idf/lite fallback is required for Stage 3 governance-safe runs"
    }
  },
  "retrievalRouting": {
    "defaultRoute": "public_reference_lookup",
    "routes": [
      {
        "id": "public_reference_lookup",
        "description": "Public facts and summary-grade value statements from allowlisted corpus artifacts.",
        "requiredSignals": ["public", "summary", "status", "updates"]
      },
      {
        "id": "tenant_surface_lookup",
        "description": "Tenant-scoped guide, onboarding and surface mapping queries.",
        "requiredSignals": ["guide", "onboarding", "place", "faq"]
      }
    ],
    "selectorPolicy": "deterministic_signal_match_then_default"
  },
  "multiStrategyGating": {
    "policy": "all_required_strategies_must_pass",
    "strategies": [
      {
        "id": "route_scope_gate",
        "required": true,
        "reason": "selected retrieval route must be allowlisted by the pilot plan"
      },
      {
        "id": "tenant_scope_filter",
        "required": true,
        "reason": "results must stay within the route-appropriate tenant/public scope"
      },
      {
        "id": "lexical_anchor_gate",
        "required": true,
        "reason": "matched tokens threshold must be satisfied before candidate promotion"
      },
      {
        "id": "claim_evidence_gate",
        "required": true,
        "reason": "returned candidates require evidence anchors"
      }
    ]
  },
  "pilotScope": [
    {
      "id": "public-presence-index",
      "source": "cortex-abv/public-presence-index.v1.json",
      "readOnly": true,
      "allowedSurface": "private_runtime",
      "purpose": "surface mapping and tenant lookup fixtures"
    },
    {
      "id": "public-project-registry",
      "source": "cortex-abv/public-project-registry.v1.json",
      "readOnly": true,
      "allowedSurface": "private_runtime",
      "purpose": "project/repo mapping and tenant tagging"
    }
  ],
  "candidatePolicy": {
    "mode": "allowlist",
    "maxReturn": 20,
    "minScoreFloor": 0.01,
    "requiresClaimEvidence": true
  },
  "safetyControls": {
    "networkCalls": false,
    "llmCalls": false,
    "writes": false,
    "publicActionAuthority": false,
    "allowExternalData": false
  },
  "evaluation": {
    "status": "proposal_only",
    "runMode": "synthetic_local_only",
    "required": [
      "schema_valid",
      "decision_reason_trace_present",
      "no_unscoped_return"
    ]
  }
}
