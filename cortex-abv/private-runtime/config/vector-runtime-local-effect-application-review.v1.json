{
  "schemaVersion": 1,
  "kind": "CortexABVVectorRuntimeLocalEffectApplicationReview",
  "version": "v1",
  "authority": "local_effect_application_review_only",
  "engine": "turbovec",
  "purpose": "Formally define whether local transition-state effects are discussable in a strictly local mode and what counts as application in that bounded context, without applying activation, state transition, source mutation, artifact mutation or public action.",
  "prerequisites": {
