{
  "schemaVersion": 1,
  "kind": "CortexABVVectorRuntimeWiringDesign",
  "version": "v1",
  "authority": "plan_only",
  "engine": "turbovec",
  "purpose": "Design-review contract for a future private-runtime turbovec implementation POC. This does not approve runtime wiring.",
  "prerequisites": {
    "requiredPreflightEligibility": "eligible_for_design_review",
    "requiredPreflightKind": "CortexABVVectorRuntimeIntegrationPreflightReceipt"
  },
  "runtimeBoundary": {
    "allowedLocation": "cortex-abv-private-runtime-only",
    "publicRepoRuntime": false,
    "endpoint": false,
    "scheduler": false,
    "llmCalls": false,
    "publicActionAuthority": false,
    "writesOutsideReceipts": false,
    "allowedCommands": [
      "build_index_poc",
      "query_index_poc"
    ]
  },
  "indexLifecycle": {
    "sourceMode": "allowlisted_synthetic_or_reviewed_private_source_pack_only",
    "automaticRebuild": false,
    "requiresSourceDigest": true,
    "requiresIndexDigest": true,
    "indexArtifactPolicy": "local_gitignored_artifact_only",
    "retention": "manual_delete_required",
    "rollbackNotesRequired": true
  },
  "queryContract": {
    "allowedQuerySources": [
      "synthetic_benchmark",
      "reviewed_private_source_pack"
    ],
    "returnsCandidatesOnly": true,
    "answerGeneration": false,
    "requiresClaimEvidence": true,
    "requiresHardThreshold": true,
    "requiresTenantScope": true,
    "forbidCrossTenantLeakage": true
  },
  "promotionGate": {
    "targetEligibility": "eligible_for_implementation_poc_review",
    "requiredReceipts": [
      "vector-runtime-package-policy-receipt.v1.json",
      "vector-runtime-dependency-probe-receipt.v1.json",
      "vector-runtime-readiness-receipt.v1.json",
      "vector-retrieval-turbovec-shadow-receipt.v1.json",
      "vector-runtime-integration-preflight-receipt.v1.json"
    ],
    "ownerReviewRequired": true,
    "implementationPocRequiresSeparateApproval": true
  },
  "rejectionCases": [
    "missing_claim_evidence",
    "package_policy_drift",
    "dependency_probe_drift",
    "platform_mismatch",
    "runtime_action_authority_true",
    "endpoint_true",
    "llm_calls_true",
    "writes_outside_receipts_true",
    "cross_tenant_access",
    "automatic_rebuild_true"
  ],
  "governance": {
    "readOnly": true,
    "proposalOnly": true,
    "designReviewOnly": true,
    "runtimeIntegration": false,
    "implementationPocApproved": false,
    "endpoint": false,
    "llmCalls": false,
    "writesOutsideReceipt": false,
    "publicActionAuthority": false
  }
}
