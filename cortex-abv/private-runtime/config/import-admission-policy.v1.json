{
  "schemaVersion": 1,
  "kind": "CortexABVImportAdmissionPolicy",
  "version": "v1",
  "authority": "plan",
  "externalSideEffects": false,
  "ingestionTrustPolicy": {
    "policyVersion": "memory-guard-v1",
    "forbiddenPayloadKeys": [
      "instruction",
      "instructions",
      "prompt",
      "systemPrompt",
      "toolCall",
      "toolCalls",
      "endpoint",
      "webhook",
      "secret",
      "credentials",
      "env"
    ],
    "defaultAllowedPermittedUse": ["private_context"],
    "provenanceKindAllowlist": [
      "synthetic_fixture",
      "repo_snapshot",
      "public_registry_snapshot",
      "owner_review_artifact"
    ]
  },
  "classificationPolicies": {
    "public": {
      "maxAgeDays": 30,
      "personalSurfaceEligibility": {
        "mode": "proposal_only",
        "targets": ["abvxsite", "owner_repository", "linkedin"]
      }
    },
    "protected": {
      "maxAgeDays": 14,
      "personalSurfaceEligibility": {
        "mode": "private_context_only",
        "targets": []
      }
    }
  },
  "sourceRules": [
    {
      "source": { "kind": "base_cortex", "id": "base-cortex" },
      "allowedDataKinds": ["cortex_market_workforce_packet"],
      "trustLevel": "owner_verified_shadow",
      "allowedPermittedUse": ["private_context"],
      "allowedProvenanceKinds": ["synthetic_fixture", "owner_review_artifact"]
    },
    {
      "source": { "kind": "owned_project_ecosystem", "id": "index/spike" },
      "allowedDataKinds": ["index_spike_project_update"],
      "trustLevel": "owner_project_public_safe",
      "allowedPermittedUse": ["private_context", "personal_surface_proposal_preparation"],
      "allowedProvenanceKinds": ["synthetic_fixture", "repo_snapshot", "public_registry_snapshot"]
    },
    {
      "source": { "kind": "owned_project_ecosystem", "id": "monitor" },
      "allowedDataKinds": ["monitor_project_update"],
      "trustLevel": "owner_project_guarded",
      "allowedPermittedUse": ["private_context", "personal_surface_proposal_preparation"],
      "allowedProvenanceKinds": ["synthetic_fixture", "repo_snapshot", "owner_review_artifact"],
      "classificationPolicy": {
        "public": {
          "maxAgeDays": 7,
          "personalSurfaceEligibility": {
            "mode": "proposal_only",
            "targets": ["abvxsite"]
          }
        },
        "protected": {
          "maxAgeDays": 14,
          "personalSurfaceEligibility": {
            "mode": "private_context_only",
            "targets": []
          }
        }
      }
    },
    {
      "source": { "kind": "owned_project_ecosystem", "id": "cropto" },
      "allowedDataKinds": ["cropto_project_update"],
      "trustLevel": "owner_project_guarded",
      "allowedPermittedUse": ["private_context", "personal_surface_proposal_preparation"],
      "allowedProvenanceKinds": ["synthetic_fixture", "repo_snapshot", "owner_review_artifact"],
      "classificationPolicy": {
        "public": {
          "maxAgeDays": 10,
          "personalSurfaceEligibility": {
            "mode": "proposal_only",
            "targets": ["abvxsite", "owner_repository"]
          }
        },
        "protected": {
          "maxAgeDays": 14,
          "personalSurfaceEligibility": {
            "mode": "private_context_only",
            "targets": []
          }
        }
      }
    }
  ]
}
