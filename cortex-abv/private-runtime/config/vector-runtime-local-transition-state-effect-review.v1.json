{
  "schemaVersion": 1,
  "kind": "CortexABVVectorRuntimeLocalTransitionStateEffectReview",
  "version": "v1",
  "authority": "local_transition_state_effect_review_only",
  "engine": "turbovec",
  "purpose": "Formally define which strictly local transition-state effects may be discussed after the bounded Stage 4z dry-run, without applying any transition, activation or broader runtime authority.",
  "prerequisites": {
    "requiredLocalTransitionDryRunReceiptKind": "CortexABVVectorRuntimeLocalActivationStateTransitionDryRunReceipt",
    "requiredLocalTransitionDryRunEligibility": "eligible_for_local_transition_state_effect_review",
    "requiredLocalTransitionDryRunStatus": "passed",
    "requiresLocalTransitionDryRunReceiptDigest": true
  },
  "effectDefinition": {
    "effectScope": "discussion_only_local_transition_state_effects",
    "sourceState": "bounded_owner_invoked_local_active_runtime_candidate",
    "effectArtifactKind": "CortexABVVectorRuntimeLocalTransitionStateEffect",
    "allowedEffects": [
      "callable_binding_ready",
      "read_only_artifact_access_confirmed",
      "tenant_scoped_candidate_queries_confirmed",
      "verified_evidence_chain_confirmed",
      "rollback_chain_preserved"
    ],
    "requiredModulePath": "src/vector-runtime-controlled-module-harness.mjs",
    "requiredBindings": [
      "loadIndexArtifact",
      "queryCandidates",
      "verifyClaimEvidence"
    ],
    "effectAppliedHere": false,
    "stateTransitionAppliedHere": false,
    "runtimeActivationAppliedHere": false,
    "persistentProcessAllowed": false,
    "daemonProcessAllowed": false,
    "schedulerAllowed": false,
    "endpointAllowed": false,
    "networkCallsAllowed": false,
    "llmCallsAllowed": false,
    "publicActionAuthorityAllowed": false
  },
  "requiredDryRunSignals": {
    "ownerApproval": [
      "approved",
      "scopeBounded"
    ],
    "module": [
      "importable",
      "bindingsPresent",
      "transitionAppliedFalse"
    ],
    "artifact": [
      "readOnly",
      "stage4hIndexDigestMatch",
      "stage4hSourceDigestMatch"
    ],
    "queries": [
      "allPassed",
      "tenantScopeEnforced",
      "candidatesOnly",
      "answerGenerationDisabled",
      "evidenceRefsVerified"
    ],
    "execution": [
      "commandsExecuted",
      "receiptOnlyWrites"
    ],
    "rollback": [
      "rollbackNotesPresent",
      "ownerRollbackMaintained"
    ]
  },
  "rollbackEffectPolicy": {
    "required": true,
    "strategy": "discard_effect_discussion_and_keep_transition_unapplied",
    "ownerReversalAllowed": true,
    "receiptOnlyEvidence": true,
    "externalMutationAllowed": false
  },
  "nextGate": {
    "targetEligibility": "eligible_for_local_transition_state_effect_artifact",
    "futureArtifactKind": "CortexABVVectorRuntimeLocalTransitionStateEffect",
    "futureArtifactMode": "local_transition_state_effect_artifact_only",
    "effectAppliedHere": false
  },
  "forbiddenAuthority": {
    "activationAppliedHere": false,
    "stateTransitionAppliedHere": false,
    "effectAppliedHere": false,
    "persistentServiceAllowed": false,
    "daemonProcessAllowed": false,
    "schedulerAllowed": false,
    "endpointAllowed": false,
    "networkCallsAllowed": false,
    "llmCallsAllowed": false,
    "publicActionAuthorityAllowed": false,
    "answerGenerationAllowed": false,
    "sourceMutationAllowed": false,
    "artifactMutationAllowed": false,
    "writesOutsideReceiptAllowed": false,
    "crossTenantQueriesAllowed": false,
    "autonomousExecutionAllowed": false
  },
