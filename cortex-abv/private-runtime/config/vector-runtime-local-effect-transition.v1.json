  },
  "ownerApproval": {
    "required": true,
    "approvalMode": "explicit_owner_manual_decision",
    "approvedByRole": "owner",
    "status": "approved",
    "scope": "bounded_local_effect_transition_artifact_only",
    "notes": "Approve only the bounded local effect transition artifact. This does not apply transition, local effects, runtime activation, or expose public action authority."
  },
  "effectTransitionDefinition": {
    "transitionScope": "strictly_local_receipt_only",
    "sourceState": "bounded_owner_initiated_local_active_runtime_candidate",
    "targetState": "bounded_owner_approved_local_effect_transition_candidate",
    "transitionMode": "owner_invoked_local_effect_plan_only",
    "allowedLocation": "cortex-abv-private-runtime-only",
