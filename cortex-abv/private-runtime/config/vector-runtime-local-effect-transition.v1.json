    "allowedBindings": [
      "loadIndexArtifact",
      "queryCandidates",
      "verifyClaimEvidence"
    ],
    "allowedLocalDecisionSteps": [
      "candidate_query_preview",
      "claim_evidence_verification",
      "rollback_readiness_review",
      "proposal_alignment_review"
    ],
    "effectTransitionAppliedHere": false,
    "stateTransitionAppliedHere": false,
    "runtimeActivationAppliedHere": false
  },
  "effectTransitionSummary": {
    "candidateQueryPreviewReady": true,
    "claimEvidenceVerificationReady": true,
    "rollbackReadinessPlanned": true,
    "proposalAlignmentConfirmed": true,
    "effectExecutionPlanned": false
  },
  "rollbackPlan": {
    "required": true,
    "strategy": "retain_effect_transition_artifact_and_keep_all_effects_unapplied",
    "steps": [
      "Discard this effect-transition artifact if digest, approval or governance checks fail.",
      "Keep runtime readonly and side-effectless until a dedicated dry-run allows execution planning.",
      "Retain only receipt evidence for this effect-transition artifact."
    ],
    "receiptOnlyEvidence": true,
    "ownerReversalAllowed": true
  },
  "nextGate": {
    "targetEligibility": "eligible_for_local_effect_transition_dry_run",
    "futureRunKind": "CortexABVVectorRuntimeLocalEffectTransitionDryRun",
    "futureRunMode": "local_effect_transition_dry_run_only",
    "effectTransitionAppliedHere": false
  },
  "forbiddenAuthority": {
    "effectAppliedHere": false,
    "stateTransitionAppliedHere": false,
    "runtimeActivationAppliedHere": false,
    "persistentServiceAllowed": false,
    "daemonProcessAllowed": false,
    "schedulerAllowed": false,
    "endpointAllowed": false,
    "networkCallsAllowed": false,
    "llmCallsAllowed": false,
    "publicActionAuthorityAllowed": false,
    "answerGenerationAllowed": false,
    "sourceMutationAllowed": false,
    "artifactMutationAllowed": false,
    "writesOutsideReceiptAllowed": false,
    "crossTenantQueriesAllowed": false,
    "autonomousExecutionAllowed": false
  },
  "rejectionCases": [
