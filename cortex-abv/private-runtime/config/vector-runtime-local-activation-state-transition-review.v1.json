{
  "schemaVersion": 1,
  "kind": "CortexABVVectorRuntimeLocalActivationStateTransitionReview",
  "version": "v1",
  "authority": "local_activation_state_transition_review_only",
  "engine": "turbovec",
  "purpose": "Define the minimal transition artifact that could move the private runtime from the inactive-ready local state to a later bounded local active state. This does not apply activation or any state transition.",
  "prerequisites": {
    "requiredLocalActivationStateReviewReceiptKind": "CortexABVVectorRuntimeLocalActivationStateReviewReceipt",
