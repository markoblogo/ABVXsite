    "requiredLocalActivationStateReviewStatus": "passed",
    "requiresLocalActivationStateReviewReceiptDigest": true
  },
  "transitionDefinition": {
    "sourceState": "inactive_ready_local_private_runtime",
    "targetState": "bounded_owner_invoked_local_active_runtime",
    "transitionArtifactKind": "CortexABVVectorRuntimeLocalActivationStateTransition",
    "transitionMode": "owner_invoked_same_process_transition_only",
    "allowedLocation": "cortex-abv-private-runtime-only",
    "allowedModulePath": "src/vector-runtime-controlled-module-harness.mjs",
    "allowedBindings": [
      "loadIndexArtifact",
      "queryCandidates",
      "verifyClaimEvidence"
    ],
    "stateTransitionAppliedHere": false,
    "persistentProcessAllowed": false,
    "daemonProcessAllowed": false,
    "schedulerAllowed": false,
    "endpointAllowed": false,
    "networkCallsAllowed": false,
    "llmCallsAllowed": false,
    "publicActionAuthorityAllowed": false
  },
  "requiredStateSignals": {
    "stateDefinition": [
      "stateExists",
      "inactiveReadyRepresentation",
      "receiptDigestStorageOnly"
    ],
    "module": [
      "importable",
      "bindingsPresent",
      "activationAppliedFalse"
    ],
    "artifact": [
      "readOnly",
      "stage4hIndexDigestMatch",
      "stage4hSourceDigestMatch"
    ],
    "queries": [
      "allPassed",
      "tenantScopeEnforced",
      "candidatesOnly",
      "answerGenerationDisabled",
      "evidenceRefsVerified"
    ],
    "rollback": [
      "rollbackStatePolicyPresent",
      "ownerReversalAllowed"
    ]
  },
  "rollbackTransitionPolicy": {
    "required": true,
    "strategy": "revert_to_inactive_ready_state_without_external_side_effects",
    "ownerReversalAllowed": true,
    "receiptOnlyEvidence": true,
    "externalMutationAllowed": false
  },
  "nextGate": {
    "targetEligibility": "eligible_for_local_activation_state_transition_artifact",
    "futureArtifactKind": "CortexABVVectorRuntimeLocalActivationStateTransition",
    "futureArtifactMode": "local_activation_state_transition_artifact_only",
    "stateTransitionAppliedHere": false
  },
  "forbiddenAuthority": {
    "activationAppliedHere": false,
    "stateTransitionAppliedHere": false,
    "persistentServiceAllowed": false,
    "daemonProcessAllowed": false,
    "schedulerAllowed": false,
    "endpointAllowed": false,
    "networkCallsAllowed": false,
    "llmCallsAllowed": false,
    "publicActionAuthorityAllowed": false,
    "answerGenerationAllowed": false,
    "sourceMutationAllowed": false,
    "artifactMutationAllowed": false,
    "writesOutsideReceiptAllowed": false,
    "crossTenantQueriesAllowed": false,
    "autonomousExecutionAllowed": false
  },
  "rejectionCases": [
